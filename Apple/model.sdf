<?xml version="1.0"?>
<sdf version='1.10'>
    <model name="apple">
        <pose> 0 0 0.5 0 0 0</pose>
        <static> false </static>

        <link name="apple_stem_link">
            <!-- <inertial>
                <mass>0.001</mass>
                <inertia>
                <ixx>0.000001</ixx>
                <iyy>0.000001</iyy>
                <izz>0.000001</izz>
                </inertia>
            </inertial> -->
        </link>
        <joint name="apple_stem_joint" type="revolute">
            <child>apple_link</child>
            <parent>apple_stem_link</parent>
        </joint>

        <link name="apple_link">
            <collision name="apple_collision">
                <geometry>
                    <mesh>
                        <uri>model://Apple/meshes/apple.dae</uri>
                        <scale>0.6 0.6 0.6</scale>
                    </mesh>
                </geometry>
            </collision>

            <visual name="apple_visual">
                <geometry>
                    <mesh>
                        <uri>model://Apple/meshes/apple.dae</uri>
                        <scale>0.6 0.6 0.6</scale>
                    </mesh>
                </geometry>
            </visual>

            <inertial>
                <mass> 0.125 </mass>
                <pose>0 0 0.03 0 0 0</pose>
                <inertia>
                    <ixx>0.0000984</ixx>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyy>0.0000984</iyy>
                    <iyz>0.0</iyz>
                    <izz>0.0000984</izz>
                </inertia>
            </inertial>
        </link>
    </model>
</sdf>