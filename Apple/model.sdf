<?xml version="1.0"?>
<sdf version='1.10'>
    <model name="Apple">
        <pose> 0 0 0.5 0 0 0</pose>
        <static> false </static>

        <!-- <joint name="stemworld_joint" type="fixed">
            <child>apple_stem_link</child>
            <parent>world</parent>
            <pose>0 0 0.1 0 0 0</pose>
        </joint> -->

        <link name="apple_stem_link">
            <inertial>
                <mass>0.001</mass>
                <inertia>
                    <ixx>1e-5</ixx>
                    <iyy>1e-5</iyy>
                    <izz>1e-5</izz>
                </inertia>
            </inertial>
        </link>

        <link name="apple_link_x">
            <inertial>
                <mass>0.001</mass>
                <inertia>
                    <ixx>1e-5</ixx>
                    <iyy>1e-5</iyy>
                    <izz>1e-5</izz>
                </inertia>
            </inertial>
        </link>

        <joint name="apple_stem_joint" type="revolute">
            <parent>apple_stem_link</parent>
            <child>apple_link_x</child>
            <pose>0 0 0.1 0 0 0</pose>
            <axis>
                <xyz>1 0 0</xyz>
                <limit>
                    <lower>-0.7</lower>
                    <upper>0.7</upper>
                </limit>
                <dynamics>
                    <damping>0.003</damping>
                </dynamics>
            </axis>
        </joint>

        <joint name="apple_joint_y" type="revolute">
            <parent>apple_link_x</parent>
            <child>apple_link</child>
            <pose>0 0 0.1 0 0 0</pose>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-0.7</lower>
                    <upper>0.7</upper>
                </limit>
                <dynamics>
                    <damping>0.003</damping>
                </dynamics>
            </axis>
        </joint>

        <link name="apple_link">
            <pose>0 0 -0.1 1.57 0 0</pose>
            <collision name="apple_collision">
                <geometry>
                    <mesh>
                        <uri>model://Apple/meshes/apple.obj</uri>
                        <scale>0.7 0.7 0.7</scale>
                    </mesh>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>4.0</mu>
                            <mu2>4.0</mu2>
                        </ode>
                        <!-- <torsional>
                            <coefficient>1.0</coefficient>
                            <use_patch_radius>true</use_patch_radius>
                            <patch_radius>0.01</patch_radius>
                        </torsional> -->
                    </friction>
                    <!-- <contact>
                        <ode>
                            <kp>1000000</kp>
                            <kd>1000</kd>
                            <max_vel>0.02</max_vel>
                            <min_depth>0.002</min_depth>
                        </ode>
                    </contact> -->
                </surface>
            </collision>

            <visual name="apple_visual">
                <geometry>
                    <mesh>
                        <uri>model://Apple/meshes/apple.obj</uri>
                        <scale>0.7 0.7 0.7</scale>
                    </mesh>
                </geometry>
            </visual>

            <inertial>
                <mass> 0.125 </mass>
                <pose>0 0 0.03 0 0 0</pose>
                <inertia>
                    <ixx>0.0000984</ixx>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyy>0.0000984</iyy>
                    <iyz>0.0</iyz>
                    <izz>0.0000984</izz>
                </inertia>
            </inertial>
        </link>
    </model>
</sdf>