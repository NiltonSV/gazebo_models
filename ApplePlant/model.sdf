<?xml version="1.0"?>
<sdf version='1.10'>
    <model name="apple_plant">
        <link name="apple_plant_link">
            <!-- Leafs do not have collision -->
            <collision name="apple_plant_collision">
                <geometry>
                    <mesh>
                        <uri>model://ApplePlant/meshes/TreeTrunk.dae</uri>
                        <scale>0.7 0.7 0.7</scale>
                    </mesh>
                </geometry>
            </collision>

            <visual name="apple_plant_visual">
                <geometry>
                    <mesh>
                        <uri>model://ApplePlant/meshes/Tree.dae</uri>
                        <scale>0.7 0.7 0.7</scale>
                    </mesh>
                </geometry>
            </visual>

            <inertial>
                <mass>20</mass>
                <inertia>
                    <ixx>6.779</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>6.779</iyy>
                    <iyz>0</iyz>
                    <izz>0.225</izz>
                </inertia>
            </inertial>
        </link>

        <joint name="world_joint" type="fixed">
            <parent>world</parent>
            <child>apple_plant_link</child>
        </joint>
    </model>
</sdf>
